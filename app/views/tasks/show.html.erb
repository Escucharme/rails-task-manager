<div class="card">
  <div class="page-header">
    <h1><%= @task.title %></h1>
    <%= link_to "✏️ Edit this task", edit_task_path(@task), class: "btn btn-outline" %>
  </div>

  <% if @task.details.present? %>
    <div class="details-box"><%= @task.details %></div>
  <% end %>

  <% if @task.completed %>
    <span class="badge badge-done">✓ This task is completed</span>
  <% else %>
    <span class="badge badge-todo">○ This task is not completed yet</span>
  <% end %>

  <%= link_to "← Back to list", tasks_path, class: "footer-link" %>
</div>
