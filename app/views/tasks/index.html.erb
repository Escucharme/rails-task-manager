<div class="card">
  <div class="page-header">
    <h1>My tasks</h1>
    <%= link_to "+ New task", new_task_path, class: "btn btn-primary" %>
  </div>

  <% if @tasks.any? %>
    <ul class="task-list">
      <% @tasks.each do |task| %>
        <li class="task-item <%= 'done' if task.completed %>">
          <span class="status-dot <%= 'done' if task.completed %>"><%= '✓' if task.completed %></span>
          <%= link_to task.title, task_path(task), class: "task-title" %>
          <%= link_to "🗑", task_path(task), class: "delete-link", title: "Delete",
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No tasks yet — add your first one! ✨</p>
  <% end %>
</div>
